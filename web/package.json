{
  "name": "snug-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser demo of Snug: place real, true-to-scale furniture in a room and get an honest fit verdict.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "optimize-models": "node scripts/optimize-models.mjs",
    "thumbs": "node scripts/make-thumbs.mjs",
    "shoot": "node scripts/shoot.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.180.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
