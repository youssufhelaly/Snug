#usda 1.0
(
    defaultPrim = "Bed"
    metersPerUnit = 1
    upAxis = "Y"
)

# Stylized placeholder bed: low frame base + mattress + headboard. Rescaled to real
# dimensions by CatalogModelLoader; shown in BUY mode only.
def Xform "Bed" (kind = "component")
{
    def Cube "Base"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.55, 0.37, 0.24)]
        float3 xformOp:translate = (0, 0.18, 0)
        float3 xformOp:scale = (1.60, 0.30, 2.00)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Mattress"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.93, 0.88, 0.77)]
        float3 xformOp:translate = (0, 0.40, 0.10)
        float3 xformOp:scale = (1.52, 0.22, 1.82)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Headboard"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.50, 0.33, 0.21)]
        float3 xformOp:translate = (0, 0.55, -0.98)
        float3 xformOp:scale = (1.60, 0.70, 0.10)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
