#usda 1.0
(
    defaultPrim = "Sofa"
    metersPerUnit = 1
    upAxis = "Y"
)

# Stylized placeholder sofa: seat + back + two arms. Authored at ~real scale, but
# CatalogModelLoader.fitTransform rescales it to each product's true dimensions, so
# only the proportions/silhouette matter. Solid displayColor (no textures — matches
# the "no texture projection" rule); the model shows in BUY mode only.
def Xform "Sofa" (kind = "component")
{
    def Cube "Seat"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.46, 0.44, 0.42)]
        float3 xformOp:translate = (0, 0.22, 0.03)
        float3 xformOp:scale = (2.0, 0.28, 0.86)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Back"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.42, 0.40, 0.38)]
        float3 xformOp:translate = (0, 0.50, -0.34)
        float3 xformOp:scale = (2.0, 0.62, 0.20)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "ArmLeft"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.42, 0.40, 0.38)]
        float3 xformOp:translate = (-0.92, 0.40, 0)
        float3 xformOp:scale = (0.18, 0.50, 0.90)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "ArmRight"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.42, 0.40, 0.38)]
        float3 xformOp:translate = (0.92, 0.40, 0)
        float3 xformOp:scale = (0.18, 0.50, 0.90)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
